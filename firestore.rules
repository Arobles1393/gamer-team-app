rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin: custom claim `admin` (lo pone functions/scripts/setAdmin.js)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Bloqueo en cualquier dirección. blocks usa id `${blockerId}_${blockedId}`
    // justamente para poder comprobarlo aquí con exists()
    function noBlockBetween(uid1, uid2) {
      return !exists(/databases/$(database)/documents/blocks/$(uid1 + '_' + uid2))
             && !exists(/databases/$(database)/documents/blocks/$(uid2 + '_' + uid1));
    }

    // Solo cambia `field` y en exactamente ±1 (contadores que actualizan
    // usuarios que no son dueños del documento)
    function onlyStepsCounter(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
             && (request.resource.data[field] == resource.data.get(field, 0) + 1
                 || request.resource.data[field] == resource.data.get(field, 0) - 1);
    }

    // ===== users =====
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ===== publicProfiles (nickname, avatar y región: lo que ven los visitantes) =====
    // users/{uid} guarda correo y teléfono, por eso los visitantes no lo leen
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
                            && request.resource.data.keys().hasOnly(['username', 'avatar', 'region'])
                            && request.resource.data.username is string;
      allow delete: if false;
    }

    // ===== posts (lectura pública: el feed se ve sin sesión) =====
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.get('interestedCount', 0) == 0;
      // El dueño edita su post (sin tocar el contador ni el autor); cualquiera
      // con sesión solo mueve interestedCount ±1 ("Me interesa")
      allow update: if isSignedIn()
                    && ((resource.data.userId == request.auth.uid
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['interestedCount', 'userId']))
                        || onlyStepsCounter('interestedCount'));
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ===== game_stats (tendencias del feed; id = encodeURIComponent(game)) =====
    // postCount lo mueve el cliente al crear/borrar posts (±1);
    // searchCount solo la Cloud Function logGameSearch (Admin SDK)
    match /game_stats/{gameId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['game', 'postCount', 'updatedAt'])
                    && request.resource.data.game is string
                    && request.resource.data.postCount == 1;
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postCount', 'updatedAt'])
                    && (request.resource.data.postCount == resource.data.get('postCount', 0) + 1
                        || request.resource.data.postCount == resource.data.get('postCount', 0) - 1);
      allow delete: if false;
    }

    // ===== post_comments (lectura pública) =====
    match /post_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ===== post_interested (lectura pública: lista de interesados del post) =====
    match /post_interested/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ===== friends =====
    match /friends/{docId} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.users;
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2
                    && noBlockBetween(request.resource.data.users[0], request.resource.data.users[1]);
      // Cualquiera de los dos puede terminar la amistad (o bloquear)
      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.users;
      allow update: if false;
    }

    // ===== friend_requests =====
    match /friend_requests/{requestId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == resource.data.senderId
                      || request.auth.uid == resource.data.receiverId);
      allow create: if isSignedIn()
                    && request.resource.data.senderId == request.auth.uid
                    && noBlockBetween(request.auth.uid, request.resource.data.receiverId);
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.receiverId;
      allow delete: if false;
    }

    // ===== notifications =====
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
                  && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
                    && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.userId;
    }

    // ===== chats =====
    match /chats/{chatId} {
      allow read: if isSignedIn()
                  && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && noBlockBetween(request.resource.data.participants[0], request.resource.data.participants[1]);

      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && noBlockBetween(
                           get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0],
                           get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1]);
        allow update, delete: if false;
      }
    }

    // ===== gaming_news (lectura pública — la escribe la Cloud Function con Admin SDK) =====
    match /gaming_news/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    // ===== group_chats/{postId} (chat del grupo de una partida) =====
    // participants = autor + interesados. El cliente lo escribe en flujos
    // concretos, cada uno validado por separado:
    // - crear: solo el autor del post, con él como único participante
    // - entrar/salir: cada quien solo a sí mismo; para entrar, su "Me
    //   interesa" (post_interested/{postId}_{uid}) debe existir en la misma
    //   transacción; el autor no puede salir de su propio grupo
    // - lastMessage: solo participantes, mientras esté activo
    // - desactivar (al borrar el post): solo el autor
    match /group_chats/{postId} {
      function postDoc() {
        return get(/databases/$(database)/documents/posts/$(postId));
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function interestAfter() {
        return existsAfter(/databases/$(database)/documents/post_interested/$(postId + '_' + request.auth.uid));
      }

      // resource == null: para comprobar si el grupo existe
      allow read: if isSignedIn()
                  && (resource == null
                      || (resource.data.active == true && request.auth.uid in resource.data.participants));

      // getAfter: se crea en el mismo batch que el post
      allow create: if isSignedIn()
                    && getAfter(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
                    && request.resource.data.postId == postId
                    && request.resource.data.participants == [request.auth.uid]
                    && request.resource.data.active == true;

      allow update: if isSignedIn() && (
        // Entrar (marcar "Me interesa")
        (changed().hasOnly(['participants'])
          && request.resource.data.participants.toSet()
               == resource.data.participants.toSet().union([request.auth.uid].toSet())
          && interestAfter())
        // Salir (quitar "Me interesa")
        || (changed().hasOnly(['participants'])
          && request.resource.data.participants.toSet()
               == resource.data.participants.toSet().difference([request.auth.uid].toSet())
          && !interestAfter()
          && postDoc().data.userId != request.auth.uid)
        // Último mensaje
        || (changed().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId'])
          && resource.data.active == true
          && request.auth.uid in resource.data.participants)
        // Desactivar al borrar el post
        || (changed().hasOnly(['active'])
          && request.resource.data.active == false
          && postDoc().data.userId == request.auth.uid)
      );

      allow delete: if false;

      match /messages/{messageId} {
        function group() {
          return get(/databases/$(database)/documents/group_chats/$(postId)).data;
        }

        allow read: if isSignedIn()
                    && group().active == true
                    && request.auth.uid in group().participants;
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && group().active == true
                      && request.auth.uid in group().participants;
        allow update, delete: if false;
      }
    }

    // ===== blocks (id `${blockerId}_${blockedId}`) =====
    match /blocks/{blockId} {
      // resource == null: para consultar si existe un bloqueo con alguien
      allow read: if isSignedIn()
                  && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
                    && request.resource.data.blockerId == request.auth.uid
                    && blockId == request.auth.uid + '_' + request.resource.data.blockedId
                    && request.resource.data.blockedId != request.auth.uid
                    && request.resource.data.participants == [request.auth.uid, request.resource.data.blockedId];
      // Solo quien bloqueó puede desbloquear
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.blockerId;
      allow update: if false;
    }

    // ===== reports (solo el admin los lee y los revisa) =====
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.targetType in ['user', 'post', 'comment']
                    && request.resource.data.reason in ['spam', 'inappropriate', 'harassment', 'impersonation', 'other'];
      // Solo marcar como revisado
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
      allow delete: if false;
    }

    // ===== steamNonces (solo Admin SDK — anti-replay del login con Steam) =====
    match /steamNonces/{nonceId} {
      allow read, write: if false;
    }
  }
}