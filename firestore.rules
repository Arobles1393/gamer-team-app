rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ===== users =====
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ===== publicProfiles (nickname, avatar y región: lo que ven los visitantes) =====
    // users/{uid} guarda correo y teléfono, por eso los visitantes no lo leen
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
                            && request.resource.data.keys().hasOnly(['username', 'avatar', 'region'])
                            && request.resource.data.username is string;
      allow delete: if false;
    }

    // ===== posts (lectura pública: el feed se ve sin sesión) =====
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ===== post_comments (lectura pública) =====
    match /post_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ===== post_interested (lectura pública: lista de interesados del post) =====
    match /post_interested/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ===== friends =====
    match /friends/{docId} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.users;
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2;
      allow update, delete: if false;
    }

    // ===== friend_requests =====
    match /friend_requests/{requestId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == resource.data.senderId
                      || request.auth.uid == resource.data.receiverId);
      allow create: if isSignedIn()
                    && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.receiverId;
      allow delete: if false;
    }

    // ===== notifications =====
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
                  && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
                    && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.userId;
    }

    // ===== chats =====
    match /chats/{chatId} {
      allow read: if isSignedIn()
                  && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    // ===== gaming_news (lectura pública — la escribe la Cloud Function con Admin SDK) =====
    match /gaming_news/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    // ===== steamNonces (solo Admin SDK — anti-replay del login con Steam) =====
    match /steamNonces/{nonceId} {
      allow read, write: if false;
    }
  }
}