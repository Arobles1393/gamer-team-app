# Copia este archivo como .env y completa los valores. Create React App
# incorpora las variables REACT_APP_* al compilar: después de cambiarlas
# hay que reiniciar npm start o volver a compilar.

# Firebase (Configuración del proyecto > Tus apps > Configuración del SDK)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# RAWG (búsqueda de juegos)
REACT_APP_RAWG_API_KEY=

# "Apoyar el proyecto": URL de la página de Ko-fi (https://ko-fi.com/<usuario>).
# Solo se acepta https://ko-fi.com/...; vacía o con otro destino, el botón no aparece.
REACT_APP_SUPPORT_URL=
