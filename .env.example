# Copia este archivo como .env y completa los valores. Create React App
# incorpora las variables REACT_APP_* al compilar: después de cambiarlas
# hay que reiniciar npm start o volver a compilar.

# Firebase (Configuración del proyecto > Tus apps > Configuración del SDK)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# RAWG (búsqueda de juegos). Con REACT_APP_RAWG_VIA_FUNCTION=true la búsqueda
# pasa por las Cloud Functions searchRawgGames/getRawgGameDetail (necesitan
# Blaze y RAWG_API_KEY en functions/.env) y REACT_APP_RAWG_API_KEY ya no hace
# falta: quítala del .env del build para que la clave no vaya en el JS.
REACT_APP_RAWG_API_KEY=
REACT_APP_RAWG_VIA_FUNCTION=

# App Check (reCAPTCHA Enterprise): clave de sitio. Vacía = App Check apagado.
# En local, un token de depuración registrado en la consola de App Check.
REACT_APP_RECAPTCHA_SITE_KEY=
REACT_APP_APPCHECK_DEBUG_TOKEN=

# Sentry (reporte de errores): DSN del proyecto. Vacío = no se envía nada.
# Solo actúa en el build de producción.
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=

# "Apoyar el proyecto": URL de la página de Ko-fi (https://ko-fi.com/<usuario>).
# Solo se acepta https://ko-fi.com/...; vacía o con otro destino, el botón no aparece.
REACT_APP_SUPPORT_URL=
