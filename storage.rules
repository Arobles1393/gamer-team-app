rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 5 * 1024 * 1024;
    }

    function isValidMedia() {
      return (request.resource.contentType.matches('image/.*')
              || request.resource.contentType.matches('video/.*'))
             && request.resource.size < 20 * 1024 * 1024;
    }

    // Chat: imágenes, videos y documentos (PDF, ZIP, Word)
    function isValidChatMedia() {
      return (request.resource.contentType.matches('image/.*')
              || request.resource.contentType.matches('video/.*')
              || request.resource.contentType == 'application/pdf'
              || request.resource.contentType.matches('application/(zip|x-zip-compressed)')
              || request.resource.contentType == 'application/msword'
              || request.resource.contentType.matches('application/vnd[.]openxmlformats-officedocument[.].*'))
             && request.resource.size < 20 * 1024 * 1024;
    }

    // ===== avatars/{userId} =====
    match /avatars/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // ===== banners/{userId} =====
    match /banners/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // ===== comments/{userId}/{fileName} =====
    match /comments/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidMedia();
      allow update: if isOwner(userId) && isValidMedia();
      allow delete: if isOwner(userId);
    }

    // ===== chats/{chatId}/{userId}/{fileName} =====
    // Solo los participantes del chat leen (lee el chat en Firestore). El
    // userId de la ruta es quien sube el archivo.
    match /chats/{chatId}/{userId}/{fileName} {
      allow read: if isSignedIn()
                  && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
      allow create: if isOwner(userId)
                    && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants
                    && isValidChatMedia();
      allow update, delete: if false;
    }
  }
}