rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Subir adjuntos de contenido social pide el correo verificado, igual
    // que en firestore.rules. Excepción: Steam entra con custom token
    // (sign_in_provider == "custom") y no tiene correo. Avatar y portada no
    // lo piden (son parte del perfil).
    function canWriteSocial() {
      return isSignedIn() && (
        request.auth.token.get('email_verified', false) == true
        || request.auth.token.firebase.sign_in_provider == 'custom'
      );
    }

    // Lista cerrada de imágenes: sin SVG (puede llevar scripts) ni formatos
    // raros (auditoría B-21). La misma que ALLOWED_IMAGE_TYPES del cliente
    function isSafeImageType() {
      return request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp', 'image/gif'];
    }

    function isValidImage() {
      return isSafeImageType()
             && request.resource.size < 5 * 1024 * 1024;
    }

    function isValidMedia() {
      return (isSafeImageType()
              || request.resource.contentType.matches('video/.*'))
             && request.resource.size < 20 * 1024 * 1024;
    }

    // Chat: imágenes, videos y documentos (PDF, ZIP, Word)
    function isValidChatMedia() {
      return (isSafeImageType()
              || request.resource.contentType.matches('video/.*')
              || request.resource.contentType == 'application/pdf'
              || request.resource.contentType.matches('application/(zip|x-zip-compressed)')
              || request.resource.contentType == 'application/msword'
              || request.resource.contentType.matches('application/vnd[.]openxmlformats-officedocument[.].*'))
             && request.resource.size < 20 * 1024 * 1024;
    }

    // Imágenes de guías (portada e insertadas en el texto): las mismas que
    // valida el cliente (services/guides/guideService.js)
    function isValidGuideImage() {
      return request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp']
             && request.resource.size < 5 * 1024 * 1024;
    }

    // ===== guides/{authorId}/{fileName} =====
    match /guides/{authorId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isOwner(authorId) && canWriteSocial() && isValidGuideImage();
      allow update, delete: if false;
    }

    // ===== avatars/{userId} =====
    match /avatars/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // ===== banners/{userId} =====
    match /banners/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // ===== comments/{userId}/{fileName} =====
    match /comments/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && canWriteSocial() && isValidMedia();
      allow update: if isOwner(userId) && canWriteSocial() && isValidMedia();
      allow delete: if isOwner(userId);
    }

    // ===== chats/{chatId}/{userId}/{fileName} =====
    // Solo los participantes del chat leen (lee el chat en Firestore). El
    // userId de la ruta es quien sube el archivo.
    match /chats/{chatId}/{userId}/{fileName} {
      allow read: if isSignedIn()
                  && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
      allow create: if isOwner(userId)
                    && canWriteSocial()
                    && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants
                    && isValidChatMedia();
      allow update, delete: if false;
    }

    // ===== group_chats/{postId}/{userId}/{fileName} =====
    // Chat del grupo de una partida: solo participantes de un grupo activo
    match /group_chats/{postId}/{userId}/{fileName} {
      allow read: if isSignedIn()
                  && firestore.get(/databases/(default)/documents/group_chats/$(postId)).data.active == true
                  && request.auth.uid in firestore.get(/databases/(default)/documents/group_chats/$(postId)).data.participants;
      allow create: if isOwner(userId)
                    && canWriteSocial()
                    && firestore.get(/databases/(default)/documents/group_chats/$(postId)).data.active == true
                    && request.auth.uid in firestore.get(/databases/(default)/documents/group_chats/$(postId)).data.participants
                    && isValidChatMedia();
      allow update, delete: if false;
    }
  }
}
