# Solo para `npm run build` (Create React App lo lee además de .env).
# No poner secretos aquí: este archivo se versiona.

# Sin source maps públicos en producción (auditoría B-20)
GENERATE_SOURCEMAP=false

# El runtime de webpack como archivo, no como <script> en línea: permite una
# Content-Security-Policy sin 'unsafe-inline' para scripts (firebase.json)
INLINE_RUNTIME_CHUNK=false

# URL del sitio para las vistas previas de enlaces (Open Graph en
# public/index.html). Cambiarla si se usa un dominio propio
REACT_APP_SITE_URL=https://gamerteam-4ed20.web.app
